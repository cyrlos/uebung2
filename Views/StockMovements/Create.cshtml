@model Lagerverwaltung.Models.StockMovement

@{
    ViewData["Title"] = "Buchung hinzufügen";
}

<h1>Buchung hinzufügen</h1>

<form asp-action="Create" method="post">

    <div asp-validation-summary="ModelOnly"
         class="text-danger"></div>

    <div class="mb-3">

        <label asp-for="ArticleId"
               class="form-label">
            Artikel
        </label>

        <select asp-for="ArticleId"
                asp-items="ViewBag.ArticleId"
                class="form-select">

            <option value="">
                -- Artikel auswählen --
            </option>

        </select>

        <span asp-validation-for="ArticleId"
              class="text-danger">
        </span>

    </div>

    <div class="mb-3">

        <label asp-for="Date"
               class="form-label">
            Datum
        </label>

        <input asp-for="Date"
               type="date"
               class="form-control" />

    </div>

    <div class="mb-3">

        <label asp-for="Quantity"
               class="form-label">
            Menge
        </label>

        <input asp-for="Quantity"
               type="number"
               min="1"
               class="form-control" />

        <span asp-validation-for="Quantity"
              class="text-danger">
        </span>

    </div>

    <div class="mb-3">

        <label asp-for="Price"
               class="form-label">
            Einkaufspreis
        </label>

        <input asp-for="Price"
               type="number"
               step="0.01"
               class="form-control" />

    </div>

    <div class="mb-3">

        <label asp-for="Type"
               class="form-label">
            Buchungstyp
        </label>

        <select asp-for="Type"
                class="form-select">

            <option value="In">
                Wareneingang
            </option>

            <option value="Out">
                Warenausgang
            </option>

        </select>

    </div>

    <button type="submit"
            class="btn btn-primary">
        Speichern
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Abbrechen
    </a>

</form>