@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "Statistik";
}

<h1>Top 3 Artikel</h1>

<table class="table table-striped">

    <thead>
        <tr>
            <th>Artikelnummer</th>
            <th>Artikel</th>
            <th>Bestand</th>
            <th>Lagerwert</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Article.ArticleNumber</td>
                <td>@item.Article.Name</td>
                <td>@item.Stock</td>
                <td>@item.TotalValue.ToString("C")</td>
            </tr>
        }

    </tbody>

</table>

<a asp-action="Index" class="btn btn-secondary">
    Zurück zum Bericht
</a>